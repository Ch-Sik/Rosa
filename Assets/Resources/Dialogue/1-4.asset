    delay: 0
    sfx: {fileID: 0}
    key: 
    flagValue: 0
    room: {fileID: 0}
  - type: 5
    target: 0
    emotion: 0
    text: "\uACF0 \uBC1C\uC790\uAD6D\uC740 \uBA87 \uBC88 \uBCF8 \uC801\uC774 \uC788\uAE34
