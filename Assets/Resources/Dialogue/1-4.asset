  - type: 4
    target: 2
    emotion: 0
    text: "\uC5B4 \uADFC\uB370 \uC7A0\uC2DC\uB9CC\uC694, \uC5D0\uD53C\uC528"
    location: 0
    position: {x: 0, y: 0}
    delay: 0
    sfx: {fileID: 0}
    key: 
    flagValue: 0
    room: {fileID: 0}
  - type: 4
    target: 2
    emotion: 0
    text: "\uC774 \uC55E\uC5D0 \uAD6C\uC2AC\uC758 \uB9C8\uB825\uACFC\uB294 \uBCC4\uAC1C\uB85C
      \uCEE4\uB2E4\uB780 \uC874\uC7AC\uAC00 \uB290\uAEF4\uC838\uC694"
    location: 0
    position: {x: 0, y: 0}
    delay: 0
    sfx: {fileID: 0}
    key: 
    flagValue: 0
    room: {fileID: 0}
  - type: 5
    target: 0
    emotion: 0
    text: "\uC774\uC815\uB3C4\uC758 \uD06C\uAE30\uB77C\uBA74 \uB291\uB300\uB098 \uACF0?
      \uC77C \uAC83 \uAC19\uC740\uB370"
    location: 0
    position: {x: 0, y: 0}
    delay: 0
    sfx: {fileID: 0}
    key: 
    flagValue: 0
    room: {fileID: 0}
  - type: 5
    target: 0
    emotion: 0
    text: "\uC774 \uADFC\uCC98\uC5D0\uC11C \uB291\uB300\uB294 \uBCF8 \uC801\uC774
      \uC5C6\uC5B4\uC694. \uADF8\uB7EC\uB2C8\uAE4C \uB291\uB300\uB294 \uC544\uB2D0
