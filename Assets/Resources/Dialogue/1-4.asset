    room: {fileID: 0}
  - type: 4
    target: 2
    emotion: 0
    text: "\uACF0\uC774\uB77C\uB2C8, \uC124\uB9C8 \uC704\uD5D8\uD558\uC9C4 \uC54A\uACA0\uC8E0...?"
