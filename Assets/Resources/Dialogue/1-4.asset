    room: {fileID: 0}
  - type: 4
    target: 2
    emotion: 0
    text: "\uC544, \uCC3E\uC558\uB124\uC694. \uC704\uCE58\uAC00... \uC804\uBC29 30\uBBF8\uD130?"
    location: 0
